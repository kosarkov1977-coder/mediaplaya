<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent" app:show_buffering="when_playing" app:show_rewind_button="true" app:show_fastforward_button="true" app:show_previous_button="false" app:show_next_button="false" app:surface_type="texture_view" app:show_timeout="3500" />
    <androidx.media3.ui.SubtitleView android:id="@+id/subtitles" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/top" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#990B0B0F" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/activity_player_text_1" android:textSize="28sp" android:contentDescription="@string/activity_player_contentdescription_2" style="@style/Widget.Material3.Button.TextButton" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="16sp" android:textColor="#FFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/lock" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_3" style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/bottom" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom" android:background="#CC0B0B0F" android:scrollbars="none" android:fillViewport="true">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/previous" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_4" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_5" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/subtitle_button" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_6" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/audio" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_7" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/speed" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_8" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/aspect" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_9" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/pip" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_10" android:contentDescription="@string/activity_player_contentdescription_11" style="@style/Widget.Material3.Button.TextButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/adjust" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/activity_player_text_12" style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/feedback" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|top" android:layout_marginTop="80dp" android:padding="16dp" android:textColor="#FFFFFF" android:textSize="18sp" android:background="@drawable/card_bg" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/unlock" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_margin="16dp" android:text="@string/activity_player_text_13" android:visibility="gone" style="@style/Widget.Material3.Button.TonalButton" />
</FrameLayout>
