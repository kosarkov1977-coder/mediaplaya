        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/item_video_text_2" android:textSize="22sp" android:contentDescription="@string/item_video_contentdescription_3" style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
